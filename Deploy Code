name: Deploy to GitHub Pages
on:
  push:
    branches:
      - main

permissions:
  contents: read
  pages: write
  id-token: write

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: !!!!!!!
        uses: actions/upload-pages-artifact@v1
        with:
          path: './https://doubledash8174.github.io/Project-1/'    # publish the repository root (change to ./docs or ./dist if needed)

      - name: Deploy to GitHub Pages
        uses: actions/deploy-pages@v1
